# Test-only values, read automatically by `docker-compose -f tests/docker-compose.test.yml`
# (compose reads .env from the compose file's directory). Paths are relative to
# the repo root, where docker-compose.yml lives; tmp/ is git-ignored.
DATA_DIR_DB=./tmp/test-postgresql18-data
DATA_DIR_MAIL=./tmp/test-mailstorage
