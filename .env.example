# Copy to .env (not committed) and adjust. docker compose reads .env automatically.

# Internet domain of this mail system.
MYDOMAIN=example.org

# Domain that locally-posted mail appears to come from. Defaults to MYDOMAIN.
#MYORIGIN=example.org

# Public hostname of the mail server. Must match the name in the TLS certificate:
# it is used as postfix's myhostname and as the name roundcube uses to reach
# postfix over STARTTLS (via a docker network alias).
MYHOSTNAME=mailserver.example.org

# Certbot certificate name, i.e. the directory in /etc/letsencrypt/live/.
# Defaults to MYDOMAIN.
#CERT_NAME=example.org
