#!/usr/bin/env bash
set -e

# Postfix's run script discovers the mounted keys and creates these files.
while [[ ! -f /run/opendkim/configured ]]; do
  sleep 1
done

if [[ ! -f /run/opendkim/enabled ]]; then
  # Keep runit from repeatedly restarting a service that is intentionally off.
  while true; do sleep 3600; done
fi

exec /usr/sbin/opendkim -x /etc/opendkim.conf -f
